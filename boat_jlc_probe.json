      ><i class=\"IconCheckFilled\"></i><span class=\"BtnTxt\">TEST</span\n            ><i class=\"IconArrowBottom\"></i\n          ></span>\n        </div>\n        <ul class=\"vjs-popup PlayerModeList\">\n          <li class=\"dvr\">\n            <span class=\"BtnWrap\"\n              ><i class=\"IconCheckFilled\"></i\n              ><span class=\"BtnTxt\">追っかけ再生</span></span\n            >\n          </li>\n          <li class=\"dvr\">\n            <span class=\"BtnWrap\"\n              ><i class=\"IconCheckFilled\"></i\n              ><span class=\"BtnTxt\">チャプター選択</span></span\n            >\n          </li>\n          <li class=\"live\">\n            <span class=\"BtnWrap\"\n              ><i class=\"IconCheckFilled\"></i\n              ><span class=\"BtnTxt\">Live</span></span\n            >\n          </li>\n          <li class=\"dvr live\">\n            <span class=\"BtnWrap\"\n              ><i class=\"IconCheckFilled\"></i\n              ><span class=\"BtnTxt\">Live（音声のみ）</span></span\n            >\n          </li>\n        </ul>\n      </div>\n    </template>\n    <!--チャプター選択ボタン-->\n    <template id=\"temlateChapterWrap\">\n      <div class=\"ChapterWrap\" style=\"display: none\">\n        <div class=\"ChapterBox01 swiper-container\">\n          <ul class=\"swiper-wrapper\">\n            <li class=\"ripple-li swiper-slide\">1R</li>\n            <li class=\"ripple-li swiper-slide\">2R</li>\n            <li class=\"ripple-li swiper-slide\">3R</li>\n            <li class=\"ripple-li swiper-slide\">4R</li>\n            <li class=\"ripple-li swiper-slide\">5R</li>\n            <li class=\"ripple-li swiper-slide\">6R</li>\n            <li class=\"ripple-li swiper-slide\">7R</li>\n            <li class=\"ripple-li swiper-slide\">8R</li>\n            <li class=\"ripple-li swiper-slide\">9R</li>\n            <li class=\"ripple-li swiper-slide\">10R</li>\n            <li class=\"ripple-li swiper-slide\">11R</li>\n            <li class=\"ripple-li swiper-slide\">1