<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:background="@color/bg"
    android:padding="48dp">

    <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Jun IPTV" android:textColor="@color/text" android:textSize="34sp" android:textStyle="bold"
        android:layout_marginBottom="34dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:gravity="center" android:weightSum="3">
        <Button android:id="@+id/tvMode" android:layout_width="0dp" android:layout_height="220dp" android:layout_weight="1"
            android:layout_margin="12dp" android:background="@drawable/mode_button" android:text="📺\nテレビ" android:textColor="@color/text" android:textSize="28sp" android:focusable="true" />
        <Button android:id="@+id/radioMode" android:layout_width="0dp" android:layout_height="220dp" android:layout_weight="1"
            android:layout_margin="12dp" android:background="@drawable/mode_button" android:text="📻\nラジオ" android:textColor="@color/text" android:textSize="28sp" android:focusable="true" />
        <Button android:id="@+id/gambleMode" android:layout_width="0dp" android:layout_height="220dp" android:layout_weight="1"
            android:layout_margin="12dp" android:background="@drawable/mode_button" android:text="🎯\nギャンブル" android:textColor="@color/text" android:textSize="28sp" android:focusable="true" />
    </LinearLayout>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="十字キー + 決定だけで操作" android:textColor="@color/muted" android:textSize="16sp" />
</LinearLayout>
