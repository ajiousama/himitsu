<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="470dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="42dp"
        android:paddingRight="28dp"
        android:background="#151920">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPTVM3U"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold"
            android:layout_marginBottom="26dp" />

        <Button
            android:id="@+id/tvMode"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/mode_button"
            android:gravity="center_vertical|start"
            android:text="📺  テレビ"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <Button
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/mode_button"
            android:gravity="center_vertical|start"
            android:text="📻  ラジオ"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <Button
            android:id="@+id/gambleMode"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/mode_button"
            android:gravity="center_vertical|start"
            android:text="🎯  ギャンブル"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <Button
            android:id="@+id/youtubeMode"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/mode_button"
            android:gravity="center_vertical|start"
            android:text="📷  ライブカメラ (YouTube)"
            android:textColor="@color/text"
            android:textSize="21sp" />

        <Button
            android:id="@+id/settingsMode"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/mode_button"
            android:gravity="center_vertical|start"
            android:text="⚙  設定"
            android:textColor="@color/text"
            android:textSize="21sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPTVM3U Hybrid Player"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="650dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Free Wi-Fi / ラジオ / 公営競技 / YouTube\nM3U・XMLTV / 番組表 / 4・6・8画面 / 追加ソース"
            android:textColor="@color/muted"
            android:textSize="19sp"
            android:lineSpacingExtra="6dp" />
    </LinearLayout>
</LinearLayout>
