<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
    <LinearLayout android:id="@+id/infoPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:orientation="vertical" android:background="#B0000000" android:padding="22dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/program" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text" android:textSize="18sp" android:layout_marginTop="6dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="↑↓ チャンネル変更　← 一覧へ　→ 情報表示切替" android:textColor="@color/muted" android:textSize="14sp" android:layout_marginTop="6dp" />
    </LinearLayout>
</FrameLayout>
