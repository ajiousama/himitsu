<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="34dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jun IPTV 設定"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/displayModeButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mode_button"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/multiViewButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mode_button"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/volumeButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mode_button"
            android:textColor="@color/text"
            android:textSize="19sp" />

        <Button
            android:id="@+id/addSourceButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mode_button"
            android:text="＋ M3U / EPGを追加"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/manageSourceButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/mode_button"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/tverButton"
            android:layout_width="620dp"
            android:layout_height="70dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/mode_button"
            android:text="TVer お気に入りを開く"
            android:textColor="@color/text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/settingsHelp"
            android:layout_width="760dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp" />
    </LinearLayout>
</ScrollView>
