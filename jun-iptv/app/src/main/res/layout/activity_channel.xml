<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@color/bg">

    <LinearLayout android:layout_width="360dp" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/panel">
        <TextView android:id="@+id/modeTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="16dp" android:textColor="@color/text" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingBottom="10dp"
            android:textColor="@color/muted" android:textSize="14sp" />
        <ListView android:id="@+id/channelList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:choiceMode="singleChoice" android:listSelector="#34445A" android:divider="#2C323D" android:dividerHeight="1dp"
            android:focusable="true" />
    </LinearLayout>

    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
        <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent"
            android:focusable="true" android:clickable="true" app:use_controller="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
            android:orientation="vertical" android:background="#B0000000" android:padding="18dp">
            <TextView android:id="@+id/nowTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/nowProgram" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/text" android:textSize="17sp" android:layout_marginTop="5dp" />
            <TextView android:id="@+id/nextProgram" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="15sp" android:layout_marginTop="3dp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
