<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#34445A" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="18dp" />
            <padding android:left="18dp" android:right="18dp" android:top="18dp" android:bottom="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1F27" />
            <stroke android:width="1dp" android:color="#3C4350" />
            <corners android:radius="18dp" />
            <padding android:left="18dp" android:right="18dp" android:top="18dp" android:bottom="18dp" />
        </shape>
    </item>
</selector>
